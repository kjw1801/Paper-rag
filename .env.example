GOOGLE_API_KEY=여기에_Gemini_API_키를_입력하세요
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
RAG_MIN_RELEVANCE=0.60

# 배포 시에만 필요한 값
# CORS_ALLOWED_ORIGINS=https://your-site.example
# RAG_INDEX_DIR=/data/chroma           # 영구 디스크 경로
# RAG_BUILD_INDEX_ON_STARTUP=1         # 인덱스가 없으면 서버 시작 시 생성
# RAG_RATE_LIMIT_PER_MINUTE=5           # 같은 IP의 분당 질문 수
# RAG_DAILY_REQUEST_LIMIT=50            # 인스턴스당 UTC 기준 하루 질문 수
# RAG_MAX_CONCURRENT_REQUESTS=2         # 동시에 실행할 Gemini 요청 수
# HOST=0.0.0.0
# PORT=8000
# RAG_RELOAD=0
